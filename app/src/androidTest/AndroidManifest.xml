<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:label="Anda Test Widgets">
        <!-- A deterministic widget provider (no configuration activity) for WidgetPickerTest. -->
        <receiver
            android:name="com.anda.launcher.TestWidgetProvider"
            android:exported="false"
            android:label="Anda test widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/test_widget_info" />
        </receiver>
    </application>
</manifest>
