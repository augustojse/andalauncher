<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hidden-API fallback for opening the notification shade without the accessibility service. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <application>
        <service
            android:name=".LauncherAccessibilityService"
            android:exported="true"
            android:label="@string/gestures_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/launcher_accessibility_service" />
        </service>
    </application>
</manifest>
